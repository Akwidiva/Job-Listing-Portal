# Example environment for Backend
# Copy to .env and update values

# MongoDB connection string
# For local: mongodb://localhost:27017/jobportal
# For Atlas: mongodb+srv://user:password@cluster.xxxxx.mongodb.net/jobportal
MONGO_URI=mongodb://localhost:27017/jobportal

# Security secrets (generate random strings for production)
JWT_SECRET=your-jwt-secret
SESSION_SECRET=your-session-secret

# URLs
FRONTEND_URL=http://localhost:3000
PORT=5000

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
